<script defer data-domain="mlq.ai" src="https://plausible.io/js/script.js"></script>

<script>
    // Initialize Bootstrap 5 dropdowns properly
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize all dropdowns with Bootstrap 5
        var dropdownElementList = [].slice.call(document.querySelectorAll('[data-bs-toggle="dropdown"]'));
        var dropdownList = dropdownElementList.map(function(dropdownToggleEl) {
            return new bootstrap.Dropdown(dropdownToggleEl);
        });
        
        // Prevent Bootstrap 4 from interfering with Bootstrap 5 dropdowns
        $('[data-bs-toggle="dropdown"]').on('click', function(e) {
            e.stopPropagation();
            // Ensure the dropdown menu is shown
            var dropdownMenu = this.nextElementSibling;
            if (dropdownMenu && dropdownMenu.classList.contains('dropdown-menu')) {
                dropdownMenu.classList.add('show');
            }
        });
        
        // Handle filter buttons
        var currentFilter = 'all';
        
        $('.search-filter-btn').on('click', function() {
            $('.search-filter-btn').removeClass('active');
            $(this).addClass('active');
            currentFilter = $(this).data('filter');
            
            // Re-trigger search if there's text
            var currentValue = $('#srh-inp').val();
            if (currentValue) {
                $('#srh-inp').autocomplete('search', currentValue);
            }
        });
        
        // Set up the autocomplete with custom source and rendering
        $('#srh-inp').autocomplete({
            minLength: 1,
            source: function(request, response) {
                $.ajax({
                    url: '/stocks/search_ticker_api/',
                    data: { term: request.term },
                    success: function(data) {
                        console.log('Current filter:', currentFilter);
                        console.log('Raw data:', data);
                        
                        var filteredData = data;
                        
                        // Apply filter based on active button
                        if (currentFilter === 'stocks') {
                            filteredData = data.filter(function(item) {
                                return !item.is_etf && !item.is_ai;
                            });
                            console.log('Filtered stocks:', filteredData);
                        } else if (currentFilter === 'etfs') {
                            filteredData = data.filter(function(item) {
                                return item.is_etf && !item.is_ai;
                            });
                            console.log('Filtered ETFs:', filteredData);
                        }
                        // For 'all', show everything (no filtering needed)
                        
                        // Add AI option at the end if there are results
                        if (filteredData.length > 0 && filteredData.length < 10 && !filteredData.some(d => d.is_ai)) {
                            filteredData.push({
                                id: 'ai-search',
                                label: 'Ask AI about "' + request.term + '"',
                                value: request.term,
                                is_ai: true
                            });
                        } else if (filteredData.length === 0) {
                            // If no results at all, only show AI option
                            filteredData.push({
                                id: 'ai-search',
                                label: 'Ask AI about "' + request.term + '"',
                                value: request.term,
                                is_ai: true
                            });
                        }
                        
                        response(filteredData);
                    }
                });
            },
            select: function(event, ui) {
                event.preventDefault();
                
                // Check if it's an AI search option
                if (ui.item.is_ai) {
                    window.location.href = '/chat/?q=' + encodeURIComponent(ui.item.value);
                } else {
                    window.location.href = '/stocks/' + ui.item.value + '/';
                }
            }
        }).data('ui-autocomplete')._renderItem = function(ul, item) {
            // Custom HTML for each search result
            if (item.is_ai) {
                // AI search option
                return $('<li>')
                    .append('<a class="search-ai-option"><i class="fas fa-robot"></i>' + item.label + '</a>')
                    .appendTo(ul);
            } else {
                // Regular stock/ETF result
                var badgeText = item.is_etf ? 'ETF' : 'Equity';
                
                var logoUrl = 'https://images.financialmodelingprep.com/symbol/' + item.value + '.png';
                
                var html = '<a>' +
                    '<div class="search-result-main">' +
                        '<div class="search-result-logo">' +
                            '<img src="' + logoUrl + '" alt="' + item.value + '" ' +
                                'onerror="this.style.display=\'none\'; this.nextElementSibling.style.display=\'flex\';">' +
                            '<i class="fas fa-building" style="display: none;"></i>' +
                        '</div>' +
                        '<div class="search-result-text">' +
                            '<div class="search-result-row">' +
                                '<span class="search-result-symbol">' + item.value + '</span>' +
                                '<span class="search-result-name">' + item.name + '</span>' +
                            '</div>' +
                            '<div class="search-result-exchange">' + item.exchange + '</div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="search-result-meta">' +
                        '<span class="search-badge">' + badgeText + '</span>' +
                    '</div>' +
                '</a>';
                
                return $('<li>').append(html).appendTo(ul);
            }
        };

        // Handle pressing Enter in the input field
        $('#srh-inp').keypress(function(event) {
            var keycode = (event.keyCode ? event.keyCode : event.which);
            if (keycode == '13') { // Check for Enter key
                event.preventDefault(); // Prevent the default behavior
                var ticker = $('#srh-inp').val();
                if(ticker) {
                    // Construct the URL and redirect
                    window.location.href = '/stocks/' + ticker + '/';
                } else {
                    alert('Please enter a ticker symbol.');
                }
            }
        });

        // Handle form submission for older browsers
        $('#search-form').on('submit', function(e) {
            e.preventDefault(); // Prevent the default form submission
            var ticker = $('#srh-inp').val();
            
            if(ticker) {
                // Construct the URL and redirect
                window.location.href = '/stocks/' + ticker + '/';
            } else {
                // Optionally handle the case where the input is empty
                alert('Please enter a ticker symbol.');
            }
        });
    });




				


   

