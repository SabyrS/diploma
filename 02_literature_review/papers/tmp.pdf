<!--
  HOW TO USE:
  data-theme: default (default), dark, light
  data-layout: fluid (default), boxed
  data-sidebar-position: left (default), right
  data-sidebar-behavior: sticky (default), fixed, compact
-->


<body data-theme="light" data-layout="fluid" data-sidebar-position="left" data-sidebar-behavior="sticky">
	<div class="wrapper">
		<div class="sidebar-backdrop" onclick="document.body.classList.remove('sidebar-collapsed')"></div>
		<nav id="sidebar" class="sidebar">
			<button type="button" class="sidebar-close" aria-label="Close menu"
				onclick="document.body.classList.remove('sidebar-collapsed')">&times;</button>
			<div class="sidebar-content js-simplebar">
				<a class="sidebar-brand" href="/">
						<h3 style="color:black;">MLQ.ai</h3></span>
        		</a>


				<ul class="sidebar-nav">
          
          <li class="sidebar-item">
						<a href="/news/" class="sidebar-link">
							<i class="align-middle" data-feather="rss"></i> <span class="align-middle">News</span>
						</a>
					</li>
          <li class="sidebar-item">
						<a href="/research/" class="sidebar-link">
							<i class="align-middle" data-feather="file-text"></i> <span class="align-middle">Research</span>
						</a>
					</li>
					<li class="sidebar-item">
						<a href="/chat/" class="sidebar-link">
							<i class="align-middle" data-feather="message-circle"></i> <span class="align-middle">Chat</span>
						</a>
					</li>
					<li class="sidebar-item">
						<a href="/stocks/" class="sidebar-link">
							<i class="align-middle" data-feather="trending-up"></i> <span class="align-middle">Stocks</span>
						</a>
					</li>
          <li class="sidebar-item">
						<a href="/investors/" class="sidebar-link">
							<i class="align-middle" data-feather="users"></i> <span class="align-middle">Investors</span>
						</a>
					</li>
					<li class="sidebar-item">
						<a href="/stocks/markets/" class="sidebar-link">
							<i class="align-middle" data-feather="globe"></i> <span class="align-middle">Markets</span>
						</a>
					</li>
				
