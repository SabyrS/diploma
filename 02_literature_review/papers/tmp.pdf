<script>
// Manual Sidebar Accordion Control V5 (Correct Hide/Show + Accordion)
document.addEventListener('DOMContentLoaded', function() {
    // Delay slightly to ensure app.js might have finished setup
    setTimeout(function() {
        const sidebar = document.getElementById('sidebar');
        if (!sidebar) return;

        const allCollapseElements = sidebar.querySelectorAll('.sidebar-dropdown.collapse');
        console.log(`Sidebar V5 script running. Found ${allCollapseElements.length} collapse elements.`);

        sidebar.addEventListener('click', function(event) {
            const clickedToggle = event.target.closest('.sidebar-link[data-bs-toggle="collapse"]');

            if (clickedToggle) {
                event.preventDefault();
                event.stopPropagation(); // Stop event here

                const targetId = clickedToggle.getAttribute('href') || clickedToggle.getAttribute('data-bs-target');
                if (!targetId) return;

                const targetElement = document.querySelector(targetId);
                if (!targetElement) return;

                const targetInstance = bootstrap.Collapse.getOrCreateInstance(targetElement);
                const isTargetCurrentlyExpanded = targetElement.classList.contains('show');

                console.log(`Clicked ${targetId}. Currently Expanded: ${isTargetCurrentlyExpanded}`);

                // --- Accordion Logic: Hide all OTHER shown elements FIRST ---
                allCollapseElements.forEach(el => {
                    // Check if it's a different element and if it's currently shown
                    if (el !== targetElement && el.classList.contains('show')) {
                        const instance = bootstrap.Collapse.getInstance(el);
                        if (instance) {
                            console.log(`Hiding sibling: ${el.id}`);
                            instance.hide(); // Tell Bootstrap to hide it
                        }
                    }
                });
                // --- End Accordion Logic ---

                // --- Toggle the clicked element AFTER handling siblings ---
                if (isTargetCurrentlyExpanded) {
                    // If it was open, hide it
                    console.log(`Manually HIDING clicked target: ${targetId}`);
                    targetInstance.hide();
                } else {
                    // If it was closed, show it
                    console.log(`Manually SHOWING clicked target: ${targetId}`);
                    targetInstance.show();
                }
                // --- End Toggle Logic ---
            }
        });
        // --- Active State Handling ---
        const currentPath = window.location.pathname;
        const sidebarLinks = document.querySelectorAll('.sidebar-link');
        
        sidebarLinks.forEach(link => {
            const href = link.getAttribute('href');
            
            // Remove any existing active classes first
            link.classList.remove('active');
            const parentItem = link.closest('.sidebar-item');
            if (parentItem) {
                parentItem.classList.remove('active');
            }
            
            // Exact match for root stocks page
            if (currentPath === '/stocks/' && href === '/stocks/') {
                link.classList.add('active');
                if (parentItem) {
                    parentItem.classList.add('active');
                }
            }
            // Exact match for AI stocks page
            else if (currentPath === '/stocks/ai/' && href === '/stocks/ai/') {
                link.classList.add('active');
                if (parentItem) {
                    parentItem.classList.add('active');
                }
            }
            // Exact match for other pages
            else if (currentPath === href) {
                link.classList.add('active');
                if (parentItem) {
                    parentItem.classList.add('active');
                }
            }
        });
        
        if (typeof feather !== 'undefined') {
            feather.replace();
        }
        // --- End Active State Handling ---

    }, 150); // Keep delay
});
</script>

