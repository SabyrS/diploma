<script>
(function() {
    var bar = document.getElementById('growthBar');
    var form = document.getElementById('growthBarForm');
    var input = document.getElementById('growthBarEmail');
    var btn = document.getElementById('growthBarBtn');
    var closeBtn = document.getElementById('growthBarClose');
    var textEl = document.getElementById('growthBarText');
    var ticker = bar.getAttribute('data-ticker');
    var offerId = bar.getAttribute('data-offer-id');
    var offerUrl = bar.getAttribute('data-offer-url');

    var DISMISS_KEY = 'growth_bar_dismissed';
    var SIGNUP_KEY = 'growth_bar_signed_up';

    var dismissed = localStorage.getItem(DISMISS_KEY);
    if (dismissed && (Date.now() - parseInt(dismissed)) < 7 * 86400000) return;
    var signedUp = localStorage.getItem(SIGNUP_KEY);
    if (signedUp && (Date.now() - parseInt(signedUp)) < 30 * 86400000) return;

    setTimeout(function() { bar.classList.add('visible'); }, 5000);

    closeBtn.addEventListener('click', function() {
        bar.classList.remove('visible');
        localStorage.setItem(DISMISS_KEY, Date.now().toString());
    });

    btn.addEventListener('click', function() {
        var email = input.value.trim();
        if (!email || !email.includes('@')) {
            input.style.borderColor = '#ef4444';
            return;
        }
        btn.textContent = '...';
        btn.disabled = true;

        fetch('/growth/capture/', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                email: email,
                offer_id: offerId || null,
                ticker: ticker || null,
                source_page: window.location.pathname,
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                localStorage.setItem(SIGNUP_KEY, Date.now().toString());
                var reportLink = data.report_url || offerUrl;
                if (reportLink) {
                    form.innerHTML = '<span class="growth-bar-success">Check your inbox!</span>';
                    textEl.innerHTML = 'Your report is ready &mdash; <a href="' + reportLink + '" style="color:#fff;text-decoration:underline;">View now</a>';
                } else {
                    form.innerHTML = '<span class="growth-bar-success">You\'re in!</span>';
                    textEl.textContent = "We'll send you our latest research.";
                }
                setTimeout(function() { bar.classList.remove('visible'); }, 8000);
            } else {
                btn.textContent = 'Try again';
                btn.disabled = false;
            }
        })
        .catch(function() {
            btn.textContent = 'Try again';
            btn.disabled = false;
        });
    });

    input.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') btn.click();
    });
})();
</script>



<style>
.growth-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(2px);
}
.growth-overlay.visible { display: flex; }
.growth-modal {
    background: #fff;
    border-radius: 12px;
    padding: 36px;
    max-width: 420px;
    width: 90%;
    position: relative;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}
.growth-modal-close {
    position: absolute;
    top: 12px;
    right: 16px;
    background: none;
    border: none;
    font-size: 1.4rem;
    color: #999;
    cursor: pointer;
    padding: 4px;
}
.growth-modal-close:hover { color: #333; }
.growth-modal-badge {
    display: inline-block;
    background: #111;
    color: #fff;
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
}
.growth-modal h2 {
    font-size: 1.3rem;
    font-weight: 700;
    color: #111;
    margin: 0 0 8px 0;
    line-height: 1.3;
}
.growth-modal p {
    font-size: 0.88rem;
    color: #666;
    margin: 0 0 20px 0;
    line-height: 1.5;
}
.growth-modal-form { display: flex; flex-direction: column; gap: 10px; }
.growth-modal-input {
    padding: 12px 14px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    font-size: 0.9rem;
    outline: none;
    width: 100%;
    box-sizing: border-box;
}
.growth-modal-input:focus { border-color: #111; }
.growth-modal-btn {
    padding: 12px;
    background: #111;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    width: 100%;
}
.growth-modal-btn:hover { background: #333; }
.growth-modal-fine {
    font-size: 0.72rem;
    color: #bbb;
    text-align: center;
    margin-top: 10px;
}
.growth-modal-success { text-align: center; }
.growth-modal-success h3 { color: #111; font-size: 1.1rem; margin: 0 0 6px 0; }
.growth-modal-success p { color: #666; font-size: 0.85rem; }
</style>

<div class="growth-overlay" id="growthModal"
     data-offer-id=""
     data-offer-url=""
     data-ticker="">
    <div class="growth-modal">
        <button class="growth-modal-close" id="growthModalClose">&times;</button>
        <div id="growthModalContent">
            <div class="growth-modal-badge">Research</div>
            
            <h2>Get AI and market research</h2>
            <p>In-depth analysis on the companies driving the AI revolution. Delivered to your inbox.</p>
            
            <div class="growth-modal-form">
                <input type="email" class="growth-modal-input" id="growthModalEmail" placeholder="Enter your email" autocomplete="email">
                <button class="growth-modal-btn" id="growthModalBtn">Send Me the Research</button>
            </div>
            <div class="growth-modal-fine">No spam. Unsubscribe anytime.</div>
        </div>
    </div>
</div>

<script>
(function() {
    var overlay = document.getElementById('growthModal');
    var closeBtn = document.getElementById('growthModalClose');
    var input = document.getElementById('growthModalEmail');
    var btn = document.getElementById('growthModalBtn');
    var content = document.getElementById('growthModalContent');
    var offerId = overlay.getAttribute('data-offer-id');
    var offerUrl = overlay.getAttribute('data-offer-url');
    var ticker = overlay.getAttribute('data-ticker');

    var DISMISS_KEY = 'growth_modal_dismissed';
    var SIGNUP_KEY = 'growth_modal_signed_up';

    // Don't show if dismissed in last 3 days or signed up in last 30
    var dismissed = localStorage.getItem(DISMISS_KEY);
    if (dismissed && (Date.now() - parseInt(dismissed)) < 3 * 86400000) return;
    var signedUp = localStorage.getItem(SIGNUP_KEY);
    if (signedUp && (Date.now() - parseInt(signedUp)) < 30 * 86400000) return;

    // Also skip if already signed up via bottom bar
    if (localStorage.getItem('growth_bar_signed_up')) return;

    var shown = false;
    function showModal() {
        if (shown) return;
        shown = true;
        overlay.classList.add('visible');
    }

    // Show after 15 seconds
    var timer = setTimeout(showModal, 15000);

    // Or after 50% scroll
    function checkScroll() {
        var scrollPercent = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight;
        if (scrollPercent > 0.5) {
            showModal();
            window.removeEventListener('scroll', checkScroll);
        }
    }
    window.addEventListener('scroll', checkScroll);

    function closeModal() {
        overlay.classList.remove('visible');
        localStorage.setItem(DISMISS_KEY, Date.now().toString());
        clearTimeout(timer);
        window.removeEventListener('scroll', checkScroll);
    }

    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', function(e) {
        if (e.target === overlay) closeModal();
    });

    btn.addEventListener('click', function() {
        var email = input.value.trim();
        if (!email || !email.includes('@')) {
            input.style.borderColor = '#ef4444';
            return;
        }
        btn.textContent = '...';
        btn.disabled = true;

        fetch('/growth/capture/', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                email: email,
                offer_id: offerId || null,
                ticker: ticker || null,
                source_page: window.location.pathname,
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                localStorage.setItem(SIGNUP_KEY, Date.now().toString());
                var reportLink = data.report_url || offerUrl;
                if (reportLink) {
                    content.innerHTML = '<div class="growth-modal-success"><h3>Your report is ready</h3><p><a href="' + reportLink + '" style="color:#111;font-weight:600;">Read it now</a> or check your inbox.</p></div>';
                } else {
                    content.innerHTML = '<div class="growth-modal-success"><h3>You\'re in!</h3><p>Check your inbox for our latest research.</p></div>';
                }
                setTimeout(function() { overlay.classList.remove('visible'); }, 4000);
            } else {
                btn.textContent = 'Try again';
                btn.disabled = false;
            }
        })
        .catch(function() {
            btn.textContent = 'Try again';
            btn.disabled = false;
        });
    });

    input.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') btn.click();
    });
})();
</script>


</body>
</html>
