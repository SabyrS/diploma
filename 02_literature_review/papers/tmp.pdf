<script>
// Simple earnings toggle function
function toggleEarnings(event) {
    event.preventDefault();
    const menu = document.getElementById('earnings-menu');
    const chevron = document.querySelector('.earnings-chevron');
    
    if (menu.style.display === 'none' || menu.style.display === '') {
        menu.style.display = 'block';
        chevron.style.transform = 'rotate(180deg)';
    } else {
        menu.style.display = 'none';
        chevron.style.transform = 'rotate(0deg)';
    }
}

// Simple calendars toggle function
function toggleCalendars(event) {
    event.preventDefault();
    const menu = document.getElementById('calendars-menu');
    const chevron = document.querySelector('.calendars-chevron');
    
    if (menu.style.display === 'none' || menu.style.display === '') {
        menu.style.display = 'block';
        chevron.style.transform = 'rotate(180deg)';
    } else {
        menu.style.display = 'none';
        chevron.style.transform = 'rotate(0deg)';
    }
}

// Simple data feeds toggle function
function toggleDataFeeds(event) {
    event.preventDefault();
    const menu = document.getElementById('data-feeds-menu');
    const chevron = document.querySelector('.data-feeds-chevron');
    
    if (menu.style.display === 'none' || menu.style.display === '') {
        menu.style.display = 'block';
        chevron.style.transform = 'rotate(180deg)';
    } else {
        menu.style.display = 'none';
        chevron.style.transform = 'rotate(0deg)';
    }
}
</script>

